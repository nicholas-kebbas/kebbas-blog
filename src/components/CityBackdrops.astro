---
import { IMAGE_SCENES } from "../lib/scenes";
// Original FFIX-inspired paintings. Image sources activate only near their scroll stops.
---

<div class="city-backdrops" aria-hidden="true">
  {IMAGE_SCENES.map((scene) => (
    <div class="city-backdrop" data-city-backdrop={scene.index} hidden>
      <picture>
        <source media="(max-width: 650px) and (max-height: 600px)" data-srcset={`/images/${scene.image}-ffix-mobile.webp`} />
        <img
          data-src={`/images/${scene.image}-ffix.webp`}
          width="1672"
          height="941"
          alt=""
          decoding="async"
          fetchpriority="low"
          draggable="false"
        />
      </picture>
    </div>
  ))}
</div>

<style>
  .city-backdrops,
  .city-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .city-backdrop { opacity: var(--city-opacity, 0); }
  picture,
  img {
    display: block;
    width: 100%;
    height: 100%;
  }
  img {
    object-fit: cover;
    object-position: 72% center;
  }
  .city-backdrops::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: var(--city-overlay-opacity, 0);
    background: linear-gradient(180deg, #05081933, transparent 24%, transparent 75%, #05081999);
  }
  @media (max-width: 650px) {
    img { object-position: 75% center; }
    .city-backdrops::after {
      background:
        linear-gradient(90deg, #05081944, transparent 65%),
        linear-gradient(180deg, #05081933, transparent 40%, transparent 75%, #050819b3);
    }
  }
</style>
