---
// An original FFIX-inspired painting, independent of the procedural WebGL renderer.
---

<div class="alexandria-backdrop" data-alexandria-backdrop aria-hidden="true">
  <picture>
    <source media="(max-width: 650px) and (max-height: 600px)" srcset="/images/alexandria-ffix-mobile.webp" />
    <img
      src="/images/alexandria-ffix.webp"
      width="1672"
      height="941"
      alt=""
      decoding="async"
      fetchpriority="low"
      draggable="false"
    />
  </picture>
</div>

<style>
  .alexandria-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: var(--alexandria-opacity, 0);
  }
  picture,
  img {
    display: block;
    width: 100%;
    height: 100%;
  }
  img {
    object-fit: cover;
    object-position: 72% center;
  }
  .alexandria-backdrop::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #05081933, transparent 24%, transparent 75%, #05081999);
  }
  @media (max-width: 650px) {
    img { object-position: 75% center; }
    .alexandria-backdrop::after {
      background:
        linear-gradient(90deg, #05081944, transparent 65%),
        linear-gradient(180deg, #05081933, transparent 40%, transparent 75%, #050819b3);
    }
  }
</style>
