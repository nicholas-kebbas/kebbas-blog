---
import BaseHead from "../components/BaseHead.astro";
import ObservatoryCanvas from "../components/ObservatoryCanvas.astro";
import AuroraBackdrop from "../components/AuroraBackdrop.astro";
import CityBackdrops from "../components/CityBackdrops.astro";
import DimensionTransitions from "../components/DimensionTransitions.astro";
import { SCENES, LAST_SCENE_INDEX } from "../lib/scenes";
import {
  GITHUB_PROFILE,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TITLE,
} from "../consts";

const homepage = new URL("/", Astro.site).href;
const profile = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: homepage,
  mainEntity: {
    "@type": "Person",
    "@id": new URL("#nick-kebbas", homepage).href,
    name: SITE_NAME,
    url: homepage,
    sameAs: [GITHUB_PROFILE],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(profile).replace(/</g, "\\u003c")}
    />
  </head>
  <body class="scroll-experience" style={`--scene-count: ${SCENES.length}; --last-scene: ${LAST_SCENE_INDEX}`}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="monogram" href="#top" aria-label="Nick Kebbas">
        n<span>k</span>
      </a>
      <nav aria-label="Projects">
        <a href="https://granularitygames.com" data-portal="Granularity Games">
          Granularity Games <span aria-hidden="true">↗</span>
        </a>
        <a href="https://bayareahousingalpha.com" data-portal="Housing Alpha">
          Housing Alpha <span aria-hidden="true">↗</span>
        </a>
        <a href={GITHUB_PROFILE} data-portal="GitHub">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <div class="scroll-landmarks" aria-hidden="true">
        {SCENES.map((scene, index) => <span id={scene.id} style={`--stop: ${index}`} />)}
        <span id="dunes" style={`--stop: ${SCENES.findIndex((scene) => scene.id === "alexandria")}`} />
      </div>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-art">
          <AuroraBackdrop />
          <CityBackdrops />
          <div class="sculpture-stage" data-sculpture-stage>
            <ObservatoryCanvas />
          </div>
        </div>
        <div class="hero-type">
          <h1 id="hero-title">
            NICK
            <br />
            <span>KEBBAS</span>
          </h1>
          <a
            class="hero-cta"
            href="mailto:nickkebbas@gmail.com"
            aria-label="Let’s work together — email Nick"
          >
            Let’s work together <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </main>
    <footer class="screen-footer">
      <span class="copyright mono">© {new Date().getFullYear()} Nick Kebbas</span>
      <div class="scene-status mono" aria-hidden="true">
        <span data-scene-number>01</span><span class="scene-divider"></span>
        <span data-scene-name>Chrome</span>
        <span class="scene-progress"><span></span></span>
      </div>
      <div class="scene-controls">
        <span class="scroll-cue mono" data-scroll-cue>Scroll to explore <span aria-hidden="true">↓</span></span>
        <details class="scene-picker" data-scene-picker>
          <summary>
            <span>Scenes</span>
            <span class="scene-picker-count mono"><span data-scene-number>01</span> / {SCENES.length}</span>
            <span class="scene-picker-arrow" aria-hidden="true">↗</span>
          </summary>
          <nav class="scene-nav" aria-label="Visual scenes">
            {SCENES.map((scene, index) => (
              <a href={`#${scene.id}`} data-scene-stop={index} data-scene-name={scene.name} aria-label={`${index + 1} of ${SCENES.length}: ${scene.name}`} aria-current={index === 0 ? "location" : undefined}>
                <span class="scene-option-number mono" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <span>{scene.name}</span>
              </a>
            ))}
          </nav>
        </details>
      </div>
    </footer>
    <DimensionTransitions />
    <script>
      import "../scripts/observatory";
    </script>
  </body>
</html>
