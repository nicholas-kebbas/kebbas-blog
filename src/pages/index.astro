---
import BaseHead from "../components/BaseHead.astro";
import ObservatoryCanvas from "../components/ObservatoryCanvas.astro";
import DimensionTransitions from "../components/DimensionTransitions.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
const rings = Array.from({ length: 12 }, (_, i) => i);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a
        class="monogram"
        href="#top"
        data-portal="Return to orbit"
        aria-label="Nick Kebbas, back to top"
      >
        n<span>k</span>
        <i>✳</i>
      </a>
      <span class="header-note mono">
        Personal observatory
        <br />
        <span>Objects & other obsessions</span>
      </span>
      <nav aria-label="Main navigation">
        <a href="#work" data-portal="Selected work">
          Work <sup>01</sup>
        </a>
        <a href="#about" data-portal="The human">
          About <sup>02</sup>
        </a>
        <a href="#lab" data-portal="Enter the field">
          Play <sup>03</sup>
        </a>
        <a href="#connect" data-portal="Make contact">
          Contact <span aria-hidden="true">↗</span>
        </a>
      </nav>
      <button
        class="motion-toggle mono"
        data-motion-toggle
        hidden
        type="button"
        aria-pressed="false"
        aria-label="Pause motion"
      >
        <span class="motion-bars" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span data-motion-label>Motion on</span>
      </button>
    </header>
    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-art">
          <ObservatoryCanvas />
        </div>
        <div class="hero-coordinate mono" aria-hidden="true">
          <span>NK—001</span>
          <span>Independent exploration</span>
          <span>↙ Move through the unknown</span>
        </div>
        <div class="hero-type">
          <p class="eyebrow">
            <span class="status-dot"></span> Software. AI. Bitcoin. What’s next.
          </p>
          <h1 id="hero-title">
            NICK
            <br />
            <span>KEBBAS</span>
            <i aria-hidden="true">✳</i>
          </h1>
          <p class="hero-intro">
            Making things.
            <br />
            Seeing where they lead.
          </p>
        </div>
        <span class="hero-margin mono" aria-hidden="true">
          Fig. 001 / An idea taking shape
        </span>
        <div class="hero-bottom">
          <a class="explore-link" href="#work" data-portal="Selected work">
            <span class="orbit-arrow" aria-hidden="true">
              ↓
            </span>
            <span>
              Step inside
              <br />
              <small>Selected work & experiments</small>
            </span>
          </a>
          <span class="hero-footnote mono">
            Nothing here is
            <br />
            in its final form.
          </span>
        </div>
      </section>
      <div class="interlude" aria-hidden="true">
        <div class="interlude-track">
          <span>FOLLOW THE CURIOSITY</span>
          <b>✳</b>
          <span>QUESTION THE OBVIOUS</span>
          <b>✳</b>
          <span>FOLLOW THE CURIOSITY</span>
          <b>✳</b>
          <span>QUESTION THE OBVIOUS</span>
          <b>✳</b>
        </div>
      </div>
      <section class="work section-pad" id="work" aria-labelledby="work-title">
        <div class="section-top mono">
          <span>01 / Selected work</span>
          <span>From abstraction to something real</span>
        </div>
        <div class="section-intro">
          <h2 id="work-title">
            Ideas need
            <br />
            <span class="serif">somewhere</span> to land.
          </h2>
          <p>
            Experiments become tools.
            <br />
            Questions become projects.
            <br />
            Occasionally, a whole new rabbit hole.
          </p>
        </div>
        <a
          class="housing-project"
          href="https://bayareahousingalpha.com"
          data-portal="Housing Alpha"
          aria-label="Explore Bay Area Housing Alpha"
        >
          <div class="housing-art" data-tilt>
            <img
              src="/images/observatory-strata.webp"
              width="1586"
              height="992"
              alt="An imagined landscape of floating basalt strata, tiny buildings, and luminous green pathways."
              loading="lazy"
              decoding="async"
            />
            <div class="housing-registration mono">
              <span>Object 01 / Finding solid ground</span>
              <span>Conceptual landscape</span>
            </div>
            <div class="housing-title" aria-hidden="true">
              <span>HOUSING</span>
              <span>
                ALPHA<i>↗</i>
              </span>
            </div>
            <svg
              class="target-mark"
              viewBox="0 0 100 100"
              fill="none"
              aria-hidden="true"
            >
              <circle cx="50" cy="50" r="33" />
              <path d="M0 50h35m30 0h35M50 0v35m0 30v35" />
            </svg>
            <span class="art-corner mono" aria-hidden="true">
              BA / 001
            </span>
          </div>
          <div class="project-caption">
            <div>
              <span class="eyebrow">An ongoing project / Research & tools</span>
              <h3>Bay Area Housing Alpha</h3>
            </div>
            <p>
              A clearer view of a big decision. Compare cities, explore public
              records, and understand the costs of a home purchase.
            </p>
            <span class="project-arrow" aria-hidden="true">
              ↗
            </span>
          </div>
        </a>
        <a
          class="source-link"
          href="https://github.com/nicholas-kebbas"
          data-portal="Open the source"
        >
          <span class="source-symbol" aria-hidden="true">
            &#123;✳&#125;
          </span>
          <div>
            <span class="eyebrow">The workshop stays open</span>
            <h3>Follow the source.</h3>
            <p>Code, prototypes, and the bits between ideas.</p>
          </div>
          <span class="source-label mono">Explore GitHub ↗</span>
        </a>
      </section>
      <section class="about" id="about" aria-labelledby="about-title">
        <div class="section-top mono section-pad">
          <span>02 / The human in the loop</span>
          <span>Nick Kebbas / A brief introduction</span>
        </div>
        <div class="specimen-scene">
          <img
            class="specimen-image"
            src="/images/observatory-specimen.webp"
            width="1586"
            height="992"
            alt="A surreal botanical sculpture made of ivory ceramic ribbons and intricate chrome branches."
            loading="lazy"
            decoding="async"
          />
          <span class="specimen-cross" aria-hidden="true">
            +
          </span>
          <div class="specimen-label mono" aria-hidden="true">
            <span>Specimen 002</span>
            <span>Curiosity, in another form.</span>
          </div>
          <h2 id="about-title">
            A little
            <br />
            <span class="serif">restless.</span>
            <br />
            Always
            <br />
            <span class="outline">curious.</span>
          </h2>
          <span class="specimen-number" aria-hidden="true">
            02
          </span>
        </div>
        <div class="about-copy section-pad">
          <p class="about-lead">
            Hi, I’m Nick.
            <br />I like the space between
            <br />
            <em>“what if”</em> and <em>“it works.”</em>
          </p>
          <div>
            <p>
              Software, AI, and Bitcoin keep pulling me into interesting
              questions. Building is how I explore them.
            </p>
            <p>
              This is my corner of the internet: part workshop, part playground.
              A place for projects that are out in the world and experiments
              that are still finding their shape.
            </p>
          </div>
        </div>
        <div class="interest-orbits" aria-label="Interests">
          <span class="mono">In orbit</span>
          <span>
            Software <i>↗</i>
          </span>
          <span>
            AI <i>✳</i>
          </span>
          <span>
            Bitcoin <i>↗</i>
          </span>
          <span class="mono">And whatever comes next.</span>
        </div>
      </section>
      <section class="lab section-pad" id="lab" aria-labelledby="lab-title">
        <div class="section-top mono">
          <span>03 / A small departure</span>
          <span>No destination required</span>
        </div>
        <div class="lab-heading">
          <h2 id="lab-title">
            Make a<br />
            <span class="serif">little</span> chaos.
          </h2>
          <p>
            An interactive field of possibilities.
            <br />
            Move your pointer through it, or change the pattern below.
          </p>
        </div>
        <div class="field-experiment" data-field>
          <svg class="field-fallback" viewBox="0 0 1200 620" aria-hidden="true">
            <g fill="none" stroke="currentColor">
              {rings.map((i) => (
                <ellipse
                  cx="600"
                  cy="310"
                  rx={150 + i * 26}
                  ry={60 + i * 15}
                  transform={`rotate(${i * 13} 600 310)`}
                  opacity={0.2 + i * 0.04}
                />
              ))}
            </g>
          </svg>
          <canvas aria-hidden="true"></canvas>
          <div class="field-readout mono" aria-hidden="true">
            <span>
              Field study / <span data-field-seed>001</span>
            </span>
            <span data-field-name>Coherence</span>
          </div>
          <div class="field-center" aria-hidden="true">
            ✳
          </div>
          <p class="sr-only" data-field-status role="status" aria-live="polite">
            Field seed 1.
          </p>
          <div class="field-controls" hidden>
            <div role="group" aria-label="Field pattern">
              <button
                type="button"
                data-field-mode="coherence"
                aria-pressed="true"
              >
                Coherence
              </button>
              <button
                type="button"
                data-field-mode="turbulence"
                aria-pressed="false"
              >
                Turbulence
              </button>
              <button
                type="button"
                data-field-mode="orbit"
                aria-pressed="false"
              >
                Orbit
              </button>
            </div>
            <button class="regenerate" type="button" data-field-regenerate>
              New seed <span aria-hidden="true">↗</span>
            </button>
          </div>
        </div>
        <div class="lab-footnote mono">
          <span>A browser experiment. No data. Just play.</span>
          <span>Try the different states ↑</span>
        </div>
      </section>
      <section
        class="connect section-pad"
        id="connect"
        aria-labelledby="connect-title"
      >
        <div class="section-top mono">
          <span>04 / Open a new channel</span>
          <span>Something on your mind?</span>
        </div>
        <div class="contact-orbit" aria-hidden="true">
          {rings.slice(0, 8).map((i) => (
            <span style={`--i:${i}`}></span>
          ))}
        </div>
        <h2 id="connect-title">
          LET’S
          <br />
          <span class="serif">make</span>
          <br />
          <span class="contact-something">
            SOMETHING<span class="lime">.</span>
          </span>
        </h2>
        <div class="connect-bottom">
          <p>
            A question, an idea,
            <br />a good rabbit hole.
            <br />
            <span>I’m listening.</span>
          </p>
          <div class="connect-links">
            <a
              href="https://twitter.com/nickkebbas"
              data-portal="Open a conversation"
            >
              Find me on X <span aria-hidden="true">↗</span>
            </a>
            <a
              href="https://github.com/nicholas-kebbas"
              data-portal="Open the workshop"
            >
              Explore my GitHub <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>
    <footer>
      <a
        class="footer-logo"
        href="#top"
        data-portal="Return to orbit"
        aria-label="Nick Kebbas, back to top"
      >
        nk<span>✳</span>
      </a>
      <span class="mono">
        © {new Date().getFullYear()} Nick Kebbas
        <br />
        <span class="footer-sub">Still a work in progress.</span>
      </span>
      <a class="mono" href="#top" data-portal="Return to orbit">
        Back to the surface ↑
      </a>
    </footer>
    <div class="cursor-orbit" aria-hidden="true"></div>
    <DimensionTransitions />
    <script>
      import "../scripts/observatory";
    </script>
  </body>
</html>
