---
import BaseHead from '../components/BaseHead.astro';
import SignalSculpture from '../components/SignalSculpture.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="monogram" href="#top" aria-label="Nick Kebbas, back to top">n<span>k</span><i>✳</i></a>
      <span class="header-note">An independent orbit.</span>
      <nav aria-label="Main navigation">
        <a href="#work">Work <span>01</span></a>
        <a href="#about">About <span>02</span></a>
        <a href="#connect">Connect <span>↗</span></a>
      </nav>
    </header>
    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-art"><SignalSculpture /></div>
        <div class="hero-kicker mono"><span class="status-dot"></span> Software / AI / Bitcoin <span class="hero-edition">Personal space — 001</span></div>
        <h1 id="hero-title"><span>NICK</span><span class="last-name">KEBBAS<span class="name-dot">.</span></span></h1>
        <div class="hero-bottom">
          <p class="hero-statement">Curiosity is the starting point.<br /><em>Building is the interesting part.</em></p>
          <a class="round-link" href="#work"><span>Explore the work</span><span class="round-arrow" aria-hidden="true">↓</span></a>
        </div>
        <span class="hero-axis mono" aria-hidden="true">Ideas → Experiments → Reality</span>
      </section>
      <div class="ticker" aria-hidden="true"><div><span>Always a work in progress</span><b>✳</b><span>Stay curious. Make things.</span><b>✳</b><span>Always a work in progress</span><b>✳</b><span>Stay curious. Make things.</span><b>✳</b></div></div>
      <section class="work section-pad" id="work" aria-labelledby="work-title">
        <div class="section-top mono"><span>01 / Selected work</span><span>Ideas, out in the world.</span></div>
        <div class="work-intro"><h2 id="work-title">Less talk.<br /><span class="serif">More tangible.</span></h2><p>A place for the things I build, the questions behind them, and whatever comes next.</p></div>
        <a class="project project-housing" href="https://bayareahousingalpha.com" target="_blank" rel="noopener noreferrer" aria-label="Explore Bay Area Housing Alpha (opens in a new tab)">
          <div class="project-visual housing-visual" aria-hidden="true">
            <div class="visual-label mono"><span>BAHA / Research & tools</span><span>37° N / 122° W</span></div>
            <div class="house-grid"></div>
            <svg class="house-drawing" viewBox="0 0 700 430" fill="none"><g stroke="currentColor" stroke-width="1.1"><path d="M78 324 333 411 631 250 376 163Z M78 324V190L333 276V411 M333 276 631 115V250 M78 190 217 39 477 126 631 115 M217 39 333 276 M477 126 631 115 M217 39 477 126 631 115 376 28Z M376 28V163 M120 209V298L200 325V236Z M236 248V337L294 357V267Z M376 283V368L458 324V239Z M491 221V306L589 253V168Z"/><path d="m59 359 274 94 318-173M78 348v23m255 63v38m298-208v29M93 174 213 42M103 177 223 46M113 180 233 49M123 184 243 52M133 187 253 56M143 190 263 59M153 194 273 62M163 197 283 66M173 200 293 69M183 204 303 72M193 207 313 76M203 210 323 79M213 214 333 82M223 217 343 86M233 220 353 89M243 224 363 92M253 227 373 96M263 230 383 99M273 234 393 102M283 237 403 106M293 240 413 109M303 244 423 112M313 247 433 116M323 250 443 119" opacity=".4"/></g></svg>
            <span class="visual-wordmark">A closer<br /><i>look.</i></span><span class="project-open" aria-hidden="true">↗</span>
          </div>
          <div class="project-caption"><div><span class="mono project-index">001 / Housing research</span><h3>Bay Area Housing Alpha</h3><p>Make sense of a home purchase. City comparisons, ownership costs, and public-record research.</p></div><span class="project-visit">Explore the project <span aria-hidden="true">↗</span></span></div>
        </a>
        <a class="code-project" href="https://github.com/nicholas-kebbas" target="_blank" rel="noopener noreferrer">
          <span class="code-mark" aria-hidden="true">{<i>✳</i>}</span><div><span class="mono project-index">002 / The workshop</span><h3>Follow the source.</h3><p>Projects, prototypes, and experiments on GitHub.</p></div><span class="code-arrow" aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span>
        </a>
      </section>
      <section class="about section-pad" id="about" aria-labelledby="about-title">
        <div class="section-top mono"><span>02 / The person behind the pixels</span><span class="about-star" aria-hidden="true">✳</span></div>
        <div class="about-body"><h2 id="about-title">Hi. I'm Nick.<br />I like the space<br />between <span class="serif">“what if”</span><br />and <span class="orange">“it works.”</span></h2><div class="about-copy"><p>Software, AI, and Bitcoin are recurring interests. I’m drawn to ideas that get more interesting when you actually try to build them.</p><p>This is my corner of the internet: part portfolio, part playground. A place to follow the work as it takes shape.</p><a class="text-link" href="https://github.com/nicholas-kebbas" target="_blank" rel="noopener noreferrer">See what I'm working on <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></div></div>
        <div class="interest-row"><span class="mono">Current orbit</span><span>Software</span><span>Artificial intelligence</span><span>Bitcoin</span><span class="orbit-icon" aria-hidden="true">↗</span></div>
      </section>
      <section class="connect section-pad" id="connect" aria-labelledby="connect-title">
        <div class="section-top mono"><span>03 / Open a conversation</span><span>Good things start somewhere.</span></div>
        <h2 id="connect-title">HAVE A<br /><span class="serif">wild</span> IDEA<span class="orange">?</span></h2>
        <div class="connect-bottom"><p>Find me on the internet.<br />Let’s see where the conversation goes.</p><div class="connect-links"><a href="https://twitter.com/nickkebbas" target="_blank" rel="noopener noreferrer">Say hello on X <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a><a href="https://github.com/nicholas-kebbas" target="_blank" rel="noopener noreferrer">Explore my GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></div></div>
      </section>
    </main>
    <footer><a class="footer-logo" href="#top" aria-label="Nick Kebbas, back to top">nk<span>✳</span></a><span class="mono">© {new Date().getFullYear()} Nick Kebbas</span><a class="mono" href="#top">Back to the surface ↑</a></footer>
  </body>
</html>
