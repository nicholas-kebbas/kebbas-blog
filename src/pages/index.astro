---
import BaseHead from "../components/BaseHead.astro";
import ObservatoryCanvas from "../components/ObservatoryCanvas.astro";
import DimensionTransitions from "../components/DimensionTransitions.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="one-screen">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="monogram" href="#top" aria-label="Nick Kebbas">
        n<span>k</span>
      </a>
      <nav aria-label="Projects">
        <a href="https://granularitygames.com" data-portal="Granularity Games">
          Granularity Games <span aria-hidden="true">↗</span>
        </a>
        <a href="https://bayareahousingalpha.com" data-portal="Housing Alpha">
          Housing Alpha <span aria-hidden="true">↗</span>
        </a>
        <a href="https://github.com/nicholas-kebbas" data-portal="GitHub">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-art">
          <ObservatoryCanvas />
        </div>
        <div class="hero-type">
          <h1 id="hero-title">
            NICK
            <br />
            <span>KEBBAS</span>
          </h1>
          <a
            class="hero-cta"
            href="https://twitter.com/nickkebbas"
            data-portal="Contact"
            aria-label="Let’s work together — contact Nick on X"
          >
            Let’s work together <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </main>
    <footer class="screen-footer mono">
      © {new Date().getFullYear()} Nick Kebbas
    </footer>
    <div class="cursor-orbit" aria-hidden="true"></div>
    <DimensionTransitions />
    <script>
      import "../scripts/observatory";
    </script>
  </body>
</html>
