---
import BaseHead from "../components/BaseHead.astro";
import ObservatoryCanvas from "../components/ObservatoryCanvas.astro";
import AuroraBackdrop from "../components/AuroraBackdrop.astro";
import DimensionTransitions from "../components/DimensionTransitions.astro";
import {
  GITHUB_PROFILE,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TITLE,
} from "../consts";

const homepage = new URL("/", Astro.site).href;
const profile = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: homepage,
  mainEntity: {
    "@type": "Person",
    "@id": new URL("#nick-kebbas", homepage).href,
    name: SITE_NAME,
    url: homepage,
    sameAs: [GITHUB_PROFILE],
  },
};
const scenes = [
  { id: "top", name: "Chrome" },
  { id: "aurora", name: "Aurora" },
  { id: "tidal", name: "Tidal" },
  { id: "corona", name: "Corona" },
  { id: "afterglow", name: "Afterglow" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(profile).replace(/</g, "\\u003c")}
    />
  </head>
  <body class="scroll-experience">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="monogram" href="#top" aria-label="Nick Kebbas">
        n<span>k</span>
      </a>
      <nav aria-label="Projects">
        <a href="https://granularitygames.com" data-portal="Granularity Games">
          Granularity Games <span aria-hidden="true">↗</span>
        </a>
        <a href="https://bayareahousingalpha.com" data-portal="Housing Alpha">
          Housing Alpha <span aria-hidden="true">↗</span>
        </a>
        <a href={GITHUB_PROFILE} data-portal="GitHub">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <div class="scroll-landmarks" aria-hidden="true">
        {scenes.map((scene, index) => <span id={scene.id} style={`--stop: ${index}`} />)}
      </div>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-art">
          <AuroraBackdrop />
          <div class="sculpture-stage" data-sculpture-stage>
            <ObservatoryCanvas />
          </div>
        </div>
        <div class="hero-type">
          <h1 id="hero-title">
            NICK
            <br />
            <span>KEBBAS</span>
          </h1>
          <div class="hero-actions">
            <a
              class="hero-cta"
              href="mailto:nickkebbas@gmail.com"
              aria-label="Let’s work together — email Nick"
            >
              Let’s work together <span aria-hidden="true">↗</span>
            </a>
            <div class="gallery-note">
              <a href="/notes/aurora-gallery/">How the gallery works <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <footer class="screen-footer">
      <span class="copyright mono">© {new Date().getFullYear()} Nick Kebbas</span>
      <div class="scene-status mono" aria-hidden="true">
        <span data-scene-number>01</span><span class="scene-divider"></span>
        <span data-scene-name>Chrome</span>
      </div>
      <div class="scene-controls">
        <span class="scroll-cue mono" data-scroll-cue>Scroll to explore <span aria-hidden="true">↓</span></span>
        <nav class="scene-nav" aria-label="Visual scenes">
          {scenes.map((scene, index) => (
            <a href={`#${scene.id}`} data-scene-stop={index} data-scene-name={scene.name} aria-label={`${index + 1} of 5: ${scene.name}`} aria-current={index === 0 ? "location" : undefined}>
              <span aria-hidden="true"></span>
            </a>
          ))}
        </nav>
      </div>
    </footer>
    <DimensionTransitions />
    <script>
      import "../scripts/observatory";
    </script>
  </body>
</html>
